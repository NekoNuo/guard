[
  { "name": "no options: every request goes on",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "mozilla" } },

  { "name": "allow: Claude Code is let in by the name people write",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "allow": ["claude-code", "codex"] } },

  { "name": "allow: Codex is let in",
    "request": { "model": "relay/gpt-5-codex", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "allow": ["claude-code", "codex"] } },

  { "name": "allow: anyone else is turned away, and the message says so",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "mozilla" },
    "options": { "allow": ["claude-code", "codex"] },
    "reject": { "status": 403, "message": "not on the allow list" } },

  { "name": "allow: an agent with no User-Agent is turned away too",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "" },
    "options": { "allow": ["claude-code", "codex"] },
    "reject": { "status": 403, "message": "couldn't name" } },

  { "name": "block wins over allow",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "cursor-local" },
    "options": { "allow": ["claude-code", "cursor"], "block": ["cursor"] },
    "reject": { "status": 403, "message": "block list" } },

  { "name": "block matches an agent by a glob",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "qodercli" },
    "options": { "block": ["qoder*"] },
    "reject": { "status": 403, "message": "qoder*" } },

  { "name": "block: the names people write reach magpie's own",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "block": ["claude-code"] },
    "reject": { "status": 403, "message": "claude-code" } },

  { "name": "byModel: a model's own list turns away another agent",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "mozilla" },
    "options": { "byModel": [{ "match": ["claude-*", "gpt-5*"], "allow": ["claude-code", "codex"] }] },
    "reject": { "status": 403, "message": "byModel[0]" } },

  { "name": "byModel: the agent it lists goes on",
    "request": { "model": "relay/gpt-5-codex", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "byModel": [{ "match": ["claude-*", "gpt-5*"], "allow": ["claude-code", "codex"] }] } },

  { "name": "byModel: the first entry that hits decides",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "byModel": [
      { "match": ["claude-*"], "allow": ["claude-code"] },
      { "match": ["*"], "allow": ["claude-code", "codex"] }] },
    "reject": { "status": 403, "message": "byModel[0]" } },

  { "name": "byModel: an empty allow means anyone",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "mozilla" },
    "options": { "allow": ["claude-code"], "byModel": [{ "match": ["claude-*"], "allow": [] }] } },

  { "name": "byModel: a model the entries do not hit falls back to allow",
    "request": { "model": "relay/deepseek-v4", "messages": [] },
    "ctx": { "agent": "mozilla" },
    "options": { "allow": ["claude-code"], "byModel": [{ "match": ["claude-*"], "allow": ["claude-code"] }] },
    "reject": { "status": 403, "message": "allow list" } },

  { "name": "a field of the wrong type is left out, and the rest still work",
    "request": { "model": "relay/deepseek-v4", "messages": [] },
    "ctx": { "agent": "mozilla" },
    "options": { "allow": "claude-code", "block": ["cursor*"] } },

  { "name": "a field of the wrong type alone turns nothing away",
    "request": { "model": "relay/deepseek-v4", "messages": [] },
    "ctx": { "agent": "mozilla" },
    "options": { "allow": "claude-code", "byModel": "claude-*" } },

  { "name": "providers: the allowed providers list filters by the model's provider",
    "request": { "model": "relay-b/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "providerAllow": ["relay-a", "relay-b"] } },

  { "name": "providers: a provider not on the allowed list is turned away",
    "request": { "model": "relay-c/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "providerAllow": ["relay-a"] },
    "reject": { "status": 403, "message": "allowed providers list" } },

  { "name": "providers: a model naming no provider is turned away while that list has names",
    "request": { "model": "claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "providerAllow": ["relay-a"] },
    "reject": { "status": 403, "message": "names no provider" } },

  { "name": "providers: the blocked providers list turns a provider away",
    "request": { "model": "relay-c/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "providerBlock": ["relay-c"] },
    "reject": { "status": 403, "message": "blocked providers list" } },

  { "name": "providers: an empty allowed list turns nothing away",
    "request": { "model": "claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "providerAllow": [] } },

  { "name": "byProvider: a rule may spell the whole group/<id> as the client writes it",
    "request": { "model": "group/translate", "messages": [] },
    "ctx": { "agent": "bob" },
    "options": { "byProvider": [{ "match": ["group/translate"], "block": ["bob"] }] },
    "reject": { "status": 403, "message": "provider \"group/translate\"'s block list" } },

  { "name": "byProvider: a group's own id is what its requests match",
    "request": { "model": "group/translate", "messages": [] },
    "ctx": { "agent": "bob" },
    "options": { "byProvider": [{ "match": ["translate"], "block": ["bob"] }] },
    "reject": { "status": 403, "message": "provider \"translate\"'s block list" } },

  { "name": "byProvider: \"group\" covers every group",
    "request": { "model": "group/translate", "messages": [] },
    "ctx": { "agent": "bob" },
    "options": { "byProvider": [{ "match": ["group"], "block": ["bob"] }] },
    "reject": { "status": 403, "message": "block list" } },

  { "name": "byProvider: a member provider's id does not reach a group request",
    "request": { "model": "group/translate", "messages": [] },
    "ctx": { "agent": "bob" },
    "options": { "byProvider": [{ "match": ["zifeiyu"], "block": ["bob"] }] } },

  { "name": "providers: a group's id works in the blocked providers list",
    "request": { "model": "group/translate", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "providerBlock": ["translate"] },
    "reject": { "status": 403, "message": "blocked providers list" } },

  { "name": "providers: a group's id works in the allowed providers list",
    "request": { "model": "group/translate", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "providerAllow": ["translate"] } },

  { "name": "providers: a group's members are not known, so a member id does not pass it",
    "request": { "model": "group/translate", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "providerAllow": ["zifeiyu"] },
    "reject": { "status": 403, "message": "allowed providers list" } },

  { "name": "byModel: its own block list turns an agent away, even one it allows",
    "request": { "model": "relay-a/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "byModel": [{ "match": ["claude-*"], "allow": ["claude-code", "codex"], "block": ["codex"] }] },
    "reject": { "status": 403, "message": "block list (match \"claude-*\")" } },

  { "name": "byModel: its block list comes before a provider's allow list",
    "request": { "model": "relay-a/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "cursor-local" },
    "options": { "byProvider": [{ "match": ["relay-a"], "allow": ["cursor"] }],
      "byModel": [{ "match": ["claude-*"], "allow": ["claude-code"], "block": ["cursor"] }] },
    "reject": { "status": 403, "message": "byModel[0]'s block list" } },

  { "name": "byProvider: a provider's own allow list turns another client away",
    "request": { "model": "relay-a/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "byProvider": [{ "match": ["relay-a"], "allow": ["claude-code"] }] },
    "reject": { "status": 403, "message": "provider \"relay-a\"" } },

  { "name": "byProvider: the client it lists goes on",
    "request": { "model": "relay-a/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "byProvider": [{ "match": ["relay-a"], "allow": ["claude-code"] }] } },

  { "name": "byProvider: a provider's block list wins over the global allow",
    "request": { "model": "relay-a/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "cursor-local" },
    "options": { "allow": ["claude-code", "cursor"], "byProvider": [{ "match": ["relay-a"], "block": ["cursor"] }] },
    "reject": { "status": 403, "message": "block list" } },

  { "name": "byProvider: an empty allow leaves the global allow in force",
    "request": { "model": "relay-a/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "allow": ["claude-code"], "byProvider": [{ "match": ["relay-a"], "block": ["cursor"] }] },
    "reject": { "status": 403, "message": "not on the allow list" } },

  { "name": "byProvider: a model rule is more specific and decides first",
    "request": { "model": "relay-a/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "byProvider": [{ "match": ["relay-a"], "allow": ["codex"] }],
      "byModel": [{ "match": ["claude-*"], "allow": ["claude-code"] }] },
    "reject": { "status": 403, "message": "byModel[0]" } },

  { "name": "byProvider: a provider entry only reaches models named with it",
    "request": { "model": "claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "allow": ["claude-code"], "byProvider": [{ "match": ["relay-a"], "allow": ["codex"] }] },
    "reject": { "status": 403, "message": "not on the allow list" } },

  { "name": "byProvider: its match takes a glob",
    "request": { "model": "relay-b/gpt-5-codex", "messages": [] },
    "ctx": { "agent": "codex" },
    "options": { "byProvider": [{ "match": ["relay-*"], "allow": ["claude-code"] }] },
    "reject": { "status": 403, "message": "provider \"relay-*\"" } },

  { "name": "onProvider leaves every provider's try as it is",
    "request": { "model": "relay/claude-sonnet-4-5", "messages": [] },
    "ctx": { "agent": "claude" },
    "options": { "allow": ["claude-code"] },
    "provider": { "id": "relay", "name": "Relay", "model": "claude-sonnet-4-5" } },

  { "name": "options that are not an object turn nothing away",
    "request": { "model": "relay/deepseek-v4", "messages": [] },
    "ctx": { "agent": "mozilla" },
    "options": ["allow", "claude-code"] }
]
